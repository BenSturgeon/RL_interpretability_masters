@misc{ren_tragedy_commons_2025,
  title = {Beyond the {{Tragedy}} of the {{Commons}}: {{Building A Reputation System}} for {{Generative Multi-agent Systems}}},
  shorttitle = {Beyond the {{Tragedy}} of the {{Commons}}},
  author = {Ren, Siyue and Fu, Wanli and Zou, Xinkun and Shen, Chen and Cai, Yi and Chu, Chen and Wang, Zhen and Hu, Shuyue},
  year = 2025,
  month = may,
  publisher = {arXiv},
  doi = {10.48550/arXiv.2505.05029},
  urldate = {2025-11-08},
  abstract = {As generative multi-agent systems grow more capable, understanding how individual self-interest leads to collectively disastrous outcomes becomes crucial for designing safe and beneficial AI ecosystems. In this work, we replicate the 'tragedy of the commons' previously observed in human studies, and show that cooperation collapses in both scenarios when agents act without RepuNet, prioritizing individual gain and driving collective exploitation. We propose RepuNet, a dynamic reputation framework operating at agent and network levels. RepuNet is driven by direct encounters and indirect gossip. Through two experimental paradigms---a voluntary participation task for reducing energy consumption and a trading investment task inspired by the trust game---we demonstrate that reputation-enabled agents self-regulate their behavior and select reputable partners for cooperation, thereby preventing the tragedy of the commons. Our experiments with 20 generative agents of diverse inclinations---some prosocial and others self-interested---using GPT-4o mini reveal rich emergent phenomena. Notably, cooperative agents with high reputations self-organized into tightly connected clusters, these clusters selectively isolated low-reputation agents with defective behaviors, and generative agents preferred sharing positive gossip rather than negative. These findings advance our understanding of emergent social dynamics in generative multi-agent systems and provide practical design principles for engineering more cooperative and trustworthy AI ecosystems.},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Multiagent Systems}
}

