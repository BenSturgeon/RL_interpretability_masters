@misc{kentonDiscoveringAgents2022,
  title = {Discovering {{Agents}}},
  author = {Kenton, Zachary and Kumar, Ramana and Farquhar, Sebastian and Richens, Jonathan and MacDermott, Matt and Everitt, Tom},
  year = 2022,
