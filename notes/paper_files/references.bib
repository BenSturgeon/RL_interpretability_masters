@misc{liReinforcementLearningHuman2023,
  title = {Reinforcement {{Learning}} with {{Human Feedback}}: {{Learning Dynamic Choices}} via {{Pessimism}}},
  shorttitle = {Reinforcement {{Learning}} with {{Human Feedback}}},
  author = {Li, Zihao and Yang, Zhuoran and Wang, Mengdi},
  year = {2023},
  month = jul,
  number = {arXiv:2305.18438},
  eprint = {2305.18438},
  primaryclass = {cs, math, stat},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2305.18438},
  urldate = {2023-08-27},
  abstract = {In this paper, we study offline Reinforcement Learning with Human Feedback (RLHF) where we aim to learn the human's underlying reward and the MDP's optimal policy from a set of trajectories induced by human choices. RLHF is challenging for multiple reasons: large state space but limited human feedback, the bounded rationality of human decisions, and the off-policy distribution shift. In this paper, we focus on the Dynamic Discrete Choice (DDC) model for modeling and understanding human choices. DCC, rooted in econometrics and decision theory, is widely used to model a human decision-making process with forward-looking and bounded rationality. We propose a {\textbackslash}underline\{D\}ynamic-{\textbackslash}underline\{C\}hoice-{\textbackslash}underline\{P\}essimistic-{\textbackslash}underline\{P\}olicy-{\textbackslash}underline\{O\}ptimization (DCPPO) method. {\textbackslash} The method involves a three-stage process: The first step is to estimate the human behavior policy and the state-action value function via maximum likelihood estimation (MLE); the second step recovers the human reward function via minimizing Bellman mean squared error using the learned value functions; the third step is to plug in the learned reward and invoke pessimistic value iteration for finding a near-optimal policy. With only single-policy coverage (i.e., optimal policy) of the dataset, we prove that the suboptimality of DCPPO almost matches the classical pessimistic offline RL algorithm in terms of suboptimality's dependency on distribution shift and dimension. To the best of our knowledge, this paper presents the first theoretical guarantees for off-policy offline RLHF with dynamic discrete choice model.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Machine Learning,Mathematics - Optimization and Control,Mathematics - Statistics Theory,Statistics - Machine Learning},
  file = {/Users/bensturgeon/Zotero/storage/KBJSB5J9/Li et al. - 2023 - Reinforcement Learning with Human Feedback Learni.pdf;/Users/bensturgeon/Zotero/storage/L68NUBE8/2305.html}
}

