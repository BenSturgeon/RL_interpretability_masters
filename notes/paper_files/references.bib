@article{schut_2025_bridging,
  title = {Bridging the Human--{{AI}} Knowledge Gap through Concept Discovery and Transfer in {{AlphaZero}}},
  author = {Schut, Lisa and Toma{\v s}ev, Nenad and McGrath, Thomas and Hassabis, Demis and Paquet, Ulrich and Kim, Been},
  year = 2025,
