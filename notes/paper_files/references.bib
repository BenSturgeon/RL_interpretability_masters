@misc{vanderweij_sandbagging_2024,
  title = {{{AI Sandbagging}}: {{Language Models}} Can {{Strategically Underperform}} on {{Evaluations}}},
  shorttitle = {{{AI Sandbagging}}},
  author = {{van der Weij}, Teun and Hofst{\"a}tter, Felix and Jaffe, Ollie and Brown, Samuel F. and Ward, Francis Rhys},
  year = 2024,
  month = jun,
  publisher = {arXiv},
  doi = {10.48550/arXiv.2406.07358},
  urldate = {2025-11-08},
  abstract = {Developers of frontier AI systems must ensure that their AI systems do not cross red lines, such as helping a bad actor to develop bioweapons. To this end, they put their AI systems through safety evaluations, which check whether the AI can do something dangerous. If the AI passes, it is deemed safe to deploy; if it fails, more safety work is needed. We investigate the robustness of this evaluation paradigm to strategic behavior from the AI system. We focus on a threat model in which the AI system wants to be deployed but knows that if it fails the evaluation, it will not be. In response, we investigate whether large language models (LLMs) strategically underperform on evaluations, which we call 'sandbagging'. We find frontier LLMs can sandbag on capability evaluations across a range of contexts. For instance, we prompt GPT-4 and Claude 3 Opus to write secure code to defend against cyberattacks. When told they will not be deployed if they perform too highly, they select and report significantly worse code. We investigate two key assumptions underpinning our work: (1) that LLMs have the capabilities to pass the evaluations even when they fail, and (2) that they can determine when to sandbag. We find evidence for both. Sandbagging exists both when we only describe the evaluation procedure to the LLM (as the 'description-only' setting) or when we also show the LLM its previous answers on other evaluation questions (as the 'history-aware' setting). We additionally show models can be easily fine-tuned to sandbag on held-out evaluations.},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Computation and Language,Computer Science - Computers and Society,Computer Science - Machine Learning}
}

@inproceedings{vig_2020_investigating,
