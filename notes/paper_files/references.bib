@misc{elhage_toy_2022,
	title = {Toy models of superposition},
	url = {https://transformer-circuits.pub/2022/toy_model/index.html},
	abstract = {We investigate how neural networks represent features when there are more features than dimensions. We find networks learn to represent multiple features in the same direction, using a nonlinear superposition where a neuron activates when either feature is present. While this preserves information, it causes neuron activations to be polysemantic and thus hard to interpret. We explore this phenomenon in toy models to get a better understanding of when it happens and why.},
	urldate = {2025-04-13},
	publisher = {Transformer Circuits Thread, Anthropic},
